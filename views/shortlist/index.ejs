<% layout("./layouts/boilerplate") %>

<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1">Campus Shortlisting Engine</h2>
      <p class="text-muted mb-0">Filter candidates dynamically based on academic eligibility criteria</p>
    </div>
    <div class="mt-2 mt-md-0">
      <a href="/admin/dashboard" class="btn btn-outline-secondary rounded-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
      </a>
    </div>
  </div>

  <!-- Filter & Criteria Form -->
  <div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
      <h5 class="fw-bold mb-0">Set Shortlisting Cutoffs</h5>
    </div>
    <div class="card-body p-4">
      <form action="/shortlist" method="POST" id="shortlistForm">
        <div class="row g-3 mb-3">
          <!-- Drive Selector for autofill -->
          <div class="col-12">
            <label for="driveSelect" class="form-label fw-semibold">Quick-fill from Drive (Optional)</label>
            <select class="form-select rounded-3" id="driveSelect" name="driveId">
              <option value="">-- Custom Criteria (All Registered Students) --</option>
              <% if (drives && drives.length > 0) { %>
                <% drives.forEach(d => { %>
                  <option 
                    value="<%= d._id %>"
                    data-tenth="<%= d.criteria.minTenthPercentage %>"
                    data-twelfth="<%= d.criteria.minTwelfthPercentage %>"
                    data-ug="<%= d.criteria.minUgCgpa %>"
                    data-pg="<%= d.criteria.minPgCgpa %>"
                    data-backlogs="<%= d.criteria.maxBacklogs %>"
                    <%= selectedDriveId && selectedDriveId.toString() === d._id.toString() ? 'selected' : '' %>
                  >
                    <%= d.name %> - <%= d.role %> (<%= d.package %>)
                  </option>
                <% }) %>
              <% } %>
            </select>
            <div class="form-text">Selecting a drive pre-fills its cutoffs and filters candidates who applied to it.</div>
          </div>

          <div class="col-md-4 col-sm-6">
            <label for="minTenthPercentage" class="form-label fw-semibold">Min 10th %</label>
            <input
              type="number"
              step="0.01"
              min="0"
              max="100"
              class="form-control rounded-3"
              id="minTenthPercentage"
              name="minTenthPercentage"
              value="<%= criteria ? criteria.minTenthPercentage : 60 %>"
              required
            />
          </div>

          <div class="col-md-4 col-sm-6">
            <label for="minTwelfthPercentage" class="form-label fw-semibold">Min 12th / Diploma %</label>
            <input
              type="number"
              step="0.01"
              min="0"
              max="100"
              class="form-control rounded-3"
              id="minTwelfthPercentage"
              name="minTwelfthPercentage"
              value="<%= criteria ? criteria.minTwelfthPercentage : 60 %>"
              required
            />
          </div>

          <div class="col-md-4 col-sm-6">
            <label for="minUgCgpa" class="form-label fw-semibold">Min UG CGPA</label>
            <input
              type="number"
              step="0.01"
              min="0"
              max="10"
              class="form-control rounded-3"
              id="minUgCgpa"
              name="minUgCgpa"
              value="<%= criteria ? criteria.minUgCgpa : 6.5 %>"
              required
            />
          </div>

          <div class="col-md-6 col-sm-6">
            <label for="minPgCgpa" class="form-label fw-semibold">Min PG CGPA</label>
            <input
              type="number"
              step="0.01"
              min="0"
              max="10"
              class="form-control rounded-3"
              id="minPgCgpa"
              name="minPgCgpa"
              value="<%= criteria ? criteria.minPgCgpa : 6.5 %>"
              required
            />
          </div>

          <div class="col-md-6 col-sm-6">
            <label for="maxBacklogs" class="form-label fw-semibold">Max Active Backlogs</label>
            <input
              type="number"
              min="0"
              class="form-control rounded-3"
              id="maxBacklogs"
              name="maxBacklogs"
              value="<%= criteria ? criteria.maxBacklogs : 0 %>"
              required
            />
          </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="/shortlist" class="btn btn-outline-secondary rounded-3">Reset</a>
          <button type="submit" class="btn btn-primary rounded-3 px-4">
            <i class="fa-solid fa-filter me-1"></i> Run Shortlisting
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Results Section -->
  <% if (shortlisted !== null) { %>
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Shortlisted Students</h5>
        <div>
          <span class="badge bg-success rounded-pill px-3 py-2 me-2"><%= shortlisted.length %> Qualified</span>
          <% if (shortlisted.length > 0) { %>
            <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">
              <i class="fa-solid fa-print me-1"></i> Print
            </button>
          <% } %>
        </div>
      </div>

      <div class="card-body p-0">
        <% if (shortlisted.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col" class="ps-3">#</th>
                  <th scope="col">Student Name</th>
                  <th scope="col">Roll / PRN</th>
                  <th scope="col">Branch</th>
                  <th scope="col">10th %</th>
                  <th scope="col">12th %</th>
                  <th scope="col">UG CGPA</th>
                  <th scope="col">PG CGPA</th>
                  <th scope="col">Backlogs</th>
                  <th scope="col" class="text-end pe-3">Resume</th>
                </tr>
              </thead>
              <tbody>
                <% shortlisted.forEach((student, index) => { %>
                  <tr>
                    <td class="ps-3 text-muted"><%= index + 1 %></td>
                    <td><div class="fw-bold text-dark"><%= student.name %></div></td>
                    <td><code><%= student.rollNo %></code></td>
                    <td><span class="badge bg-light text-dark border"><%= student.branch %></span></td>
                    <td><%= student.tenthPercentage %>%</td>
                    <td><%= student.twelfthPercentage %>%</td>
                    <td><strong class="text-primary"><%= student.ugCgpa %></strong></td>
                    <td><%= student.pgCgpa %></td>
                    <td>
                      <span class="badge <%= student.activeBacklogs === 0 ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' %>">
                        <%= student.activeBacklogs %>
                      </span>
                    </td>
                    <td class="text-end pe-3">
                      <% if (student.resumeLink) { %>
                        <a href="<%= student.resumeLink %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                          <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> View
                        </a>
                      <% } else { %>
                        <span class="text-muted small">N/A</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5">
            <i class="fa-solid fa-user-xmark fs-1 text-muted mb-3 d-block"></i>
            <h5 class="fw-bold">No students met the criteria</h5>
            <p class="text-muted small mb-0">Try lowering the CGPA or percentage cutoffs to broaden the pool.</p>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<script>
  // Drive select quick autofill
  const driveSelect = document.getElementById('driveSelect');
  if (driveSelect) {
    driveSelect.addEventListener('change', function () {
      const selected = this.options[this.selectedIndex];
      if (selected && selected.dataset.tenth !== undefined) {
        document.getElementById('minTenthPercentage').value = selected.dataset.tenth;
        document.getElementById('minTwelfthPercentage').value = selected.dataset.twelfth;
        document.getElementById('minUgCgpa').value = selected.dataset.ug;
        document.getElementById('minPgCgpa').value = selected.dataset.pg;
        document.getElementById('maxBacklogs').value = selected.dataset.backlogs;
      }
    });
  }
</script>
