<% layout("./layouts/boilerplate") %>

<div class="container py-5">
  <div class="row mb-4 text-center">
    <div class="col">
      <h1 class="fw-bold">Active Campus Drives</h1>
      <p class="text-muted">Select a company drive below to review requirements and submit your application.</p>
      <% if (currentUser) { %>
        <div class="mt-2">
          <a href="/admin/dashboard" class="btn btn-outline-primary btn-sm me-2">
            <i class="fa-solid fa-gauge me-1"></i> Admin Dashboard
          </a>
          <a href="/drives/new" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-plus me-1"></i> Add New Drive
          </a>
        </div>
      <% } %>
    </div>
  </div>

  <div class="row g-4">
    <% if (companies && companies.length > 0) { %>
      <% companies.forEach(company => { %>
        <% const isExpired = new Date(company.deadline) < new Date(); %>
        <div class="col-md-6 col-lg-4">
          <div class="card shadow-sm border-0 h-100 rounded-3">
            <div class="card-body d-flex flex-column justify-content-between p-4">
              <div>
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h4 class="card-title fw-bold text-primary mb-0"><%= company.name %></h4>
                  <% if (isExpired) { %>
                    <span class="badge bg-danger-subtle text-danger">Closed</span>
                  <% } else { %>
                    <span class="badge bg-success-subtle text-success">Active</span>
                  <% } %>
                </div>
                <h6 class="text-secondary mb-3"><%= company.role %></h6>
                <p class="text-muted small mb-3"><%= company.description %></p>
                
                <div class="bg-light p-3 rounded-3 mb-3">
                  <ul class="list-unstyled small text-muted mb-0">
                    <li class="mb-1"><strong>Package:</strong> <span class="text-dark fw-semibold"><%= company.package %></span></li>
                    <li class="mb-1"><strong>Min 10th:</strong> <%= company.criteria.minTenthPercentage %>%</li>
                    <li class="mb-1"><strong>Min 12th:</strong> <%= company.criteria.minTwelfthPercentage %>%</li>
                    <li class="mb-1"><strong>Min UG CGPA:</strong> <%= company.criteria.minUgCgpa %></li>
                    <li class="mb-1"><strong>Max Backlogs:</strong> <%= company.criteria.maxBacklogs %></li>
                    <li><strong>Deadline:</strong> <span class="<%= isExpired ? 'text-danger fw-semibold' : '' %>"><%= new Date(company.deadline).toLocaleDateString() %></span></li>
                  </ul>
                </div>
              </div>
              <div class="d-grid gap-2">
                <% if (!isExpired) { %>
                  <a href="/drives/<%= company._id %>/apply" class="btn btn-primary rounded-3">
                    <i class="fa-solid fa-paper-plane me-1"></i> Apply Now
                  </a>
                <% } else { %>
                  <button class="btn btn-secondary rounded-3" disabled>Applications Closed</button>
                <% } %>
                <% if (currentUser) { %>
                  <a href="/drives/<%= company._id %>/shortlist" class="btn btn-outline-success rounded-3 btn-sm">
                    <i class="fa-solid fa-list-check me-1"></i> View Shortlist
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col text-center py-5">
        <i class="fa-solid fa-briefcase fs-1 text-muted mb-3 d-block"></i>
        <h4 class="fw-bold">No active campus drives right now</h4>
        <p class="text-muted lead">Check back later or contact your college Training & Placement cell.</p>
        <% if (currentUser) { %>
          <a href="/drives/new" class="btn btn-primary">Create First Drive</a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
