<% layout("./layouts/boilerplate") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
          <div class="text-center mb-4">
            <h2 class="fw-bold">Apply for <%= drive.name || drive.companyName %></h2>
            <p class="text-muted">
              Role: <strong><%= drive.role %></strong> | Package:
              <strong><%= drive.package %></strong>
            </p>
          </div>

          <!-- Form action points to the submission route with the specific drive ID -->
          <form
            action="/drive/apply/<%= drive._id %>"
            method="POST"
            class="needs-validation"
            novalidate
          >
            <!-- Hidden input to store drive reference -->
            <input type="hidden" name="driveId" value="<%= drive._id %>" />

            <!-- Full Name -->
            <div class="mb-3">
              <label for="name" class="form-label fw-semibold">Full Name</label>
              <input
                type="text"
                class="form-control rounded-3"
                id="name"
                name="name"
                required
                placeholder="Enter your full name"
              />
            </div>

            <!-- Roll Number / PRN -->
            <div class="mb-3">
              <label for="rollNo" class="form-label fw-semibold"
                >Roll Number / PRN</label
              >
              <input
                type="text"
                class="form-control rounded-3"
                id="rollNo"
                name="rollNo"
                required
                placeholder="e.g., 126M1H039"
              />
            </div>

            <!-- Branch -->
            <div class="mb-3">
              <label for="branch" class="form-label fw-semibold"
                >Branch / Department</label
              >
              <select
                class="form-select rounded-3"
                id="branch"
                name="branch"
                required
              >
                <option value="" selected disabled>Select your branch</option>
                <option value="MCA">
                  Master of Computer Applications (MCA)
                </option>
                <option value="Computer Engineering">
                  Computer Engineering
                </option>
                <option value="Information Technology">
                  Information Technology
                </option>
                <option value="E&TC">Electronics & Telecommunication</option>
                <option value="Mechanical">Mechanical Engineering</option>
              </select>
            </div>

            <!-- Percentages Row -->
            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="tenthPercentage" class="form-label fw-semibold"
                  >10th Percentage (%)</label
                >
                <input
                  type="number"
                  step="0.01"
                  min="0"
                  max="100"
                  class="form-control rounded-3"
                  id="tenthPercentage"
                  name="tenthPercentage"
                  required
                  placeholder="e.g., 88.50"
                />
              </div>
              <div class="col-md-6 mb-3">
                <label for="twelfthPercentage" class="form-label fw-semibold"
                  >12th / Diploma Percentage (%)</label
                >
                <input
                  type="number"
                  step="0.01"
                  min="0"
                  max="100"
                  class="form-control rounded-3"
                  id="twelfthPercentage"
                  name="twelfthPercentage"
                  required
                  placeholder="e.g., 85.00"
                />
              </div>
            </div>

            <!-- CGPA Row -->
            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="ugCgpa" class="form-label fw-semibold"
                  >UG CGPA</label
                >
                <input
                  type="number"
                  step="0.01"
                  min="0"
                  max="10"
                  class="form-control rounded-3"
                  id="ugCgpa"
                  name="ugCgpa"
                  required
                  placeholder="e.g., 8.61"
                />
              </div>
              <div class="col-md-6 mb-3">
                <label for="pgCgpa" class="form-label fw-semibold"
                  >PG CGPA (or Current CGPA)</label
                >
                <input
                  type="number"
                  step="0.01"
                  min="0"
                  max="10"
                  class="form-control rounded-3"
                  id="pgCgpa"
                  name="pgCgpa"
                  required
                  placeholder="e.g., 9.00"
                />
              </div>
            </div>

            <!-- Resume Link & Backlogs -->
            <div class="mb-3">
              <label for="resumeLink" class="form-label fw-semibold"
                >Resume Link (Google Drive / Portfolio URL)</label
              >
              <input
                type="url"
                class="form-control rounded-3"
                id="resumeLink"
                name="resumeLink"
                required
                placeholder="https://drive.google.com/file/d/..."
              />
            </div>

            <div class="mb-4">
              <label for="activeBacklogs" class="form-label fw-semibold"
                >Active Backlogs</label
              >
              <input
                type="number"
                min="0"
                class="form-control rounded-3"
                id="activeBacklogs"
                name="activeBacklogs"
                value="0"
                required
              />
            </div>

            <!-- Submit Button -->
            <div class="d-grid">
              <button type="submit" class="btn btn-success btn-lg rounded-3">
                Submit Application
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
