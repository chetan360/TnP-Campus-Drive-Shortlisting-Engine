<% layout("./layouts/boilerplate") %>

<div class="container py-5">
  <div class="row mb-4 text-center">
    <div class="col">
      <h1 class="fw-bold">Campus Drive Results & Updates</h1>
      <p class="text-muted">View status and shortlists of ongoing and concluded campus placement drives.</p>
    </div>
  </div>

  <div class="row g-4">
    <% if (drives && drives.length > 0) { %>
      <% drives.forEach(drive => { %>
        <% const isExpired = new Date(drive.deadline) < new Date(); %>
        <div class="col-md-6 col-lg-4">
          <div class="card shadow-sm border-0 h-100 rounded-3">
            <div class="card-body d-flex flex-column justify-content-between p-4">
              <div>
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h4 class="card-title fw-bold text-primary mb-0"><%= drive.name %></h4>
                  <% if (isExpired) { %>
                    <span class="badge bg-secondary">Concluded</span>
                  <% } else { %>
                    <span class="badge bg-success">In Progress</span>
                  <% } %>
                </div>
                <h6 class="text-secondary mb-3"><%= drive.role %></h6>
                <p class="text-muted small mb-3"><%= drive.description %></p>

                <ul class="list-unstyled small text-muted mb-4">
                  <li><strong>Package:</strong> <%= drive.package %></li>
                  <li><strong>Deadline:</strong> <%= new Date(drive.deadline).toLocaleDateString() %></li>
                  <li><strong>Min UG CGPA:</strong> <%= drive.criteria.minUgCgpa %></li>
                </ul>
              </div>

              <div class="d-grid gap-2">
                <% if (currentUser) { %>
                  <a href="/drives/<%= drive._id %>/shortlist" class="btn btn-primary rounded-3">
                    <i class="fa-solid fa-list-check me-1"></i> View Shortlist
                  </a>
                <% } else { %>
                  <a href="/drives/<%= drive._id %>/apply" class="btn btn-outline-primary rounded-3 <%= isExpired ? 'disabled' : '' %>">
                    <%= isExpired ? 'Applications Closed' : 'Apply for Drive' %>
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col text-center py-5">
        <p class="text-muted lead">No campus drive results to display at this moment.</p>
        <a href="/drives" class="btn btn-outline-primary">Check Active Drives</a>
      </div>
    <% } %>
  </div>
</div>
