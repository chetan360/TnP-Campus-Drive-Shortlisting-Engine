<% layout("./layouts/boilerplate") %>

<div class="container py-5">
  <!-- Hero Section -->
  <div class="row justify-content-center text-center mb-5">
    <div class="col-lg-9">
      <div class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill mb-3">
        Training & Placement Automated Suite
      </div>
      <h1 class="display-4 fw-bold mb-3 text-dark">
        TnP Campus Drive Shortlisting Engine
      </h1>
      <p class="lead text-muted mx-auto" style="max-width: 720px;">
        Empower your campus placement cell with high-speed automated eligibility screening, candidate application management, and instant drive shortlisting.
      </p>
    </div>
  </div>

  <!-- Navigation Action Cards -->
  <div class="row justify-content-center g-4">
    <!-- Admin Portal Card -->
    <div class="col-md-5 col-lg-4">
      <div class="card shadow-sm border-0 h-100 rounded-3">
        <div class="card-body d-flex flex-column justify-content-between p-4 text-center">
          <div>
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex p-3 mb-3">
              <i class="fa-solid fa-user-shield fs-3"></i>
            </div>
            <h5 class="card-title fw-bold mb-2">TnP Admin Portal</h5>
            <p class="text-muted small mb-4">
              Authorized TnP cell members can create and manage company drives, define eligibility cutoffs, and export candidate shortlists.
            </p>
          </div>
          <div class="d-grid gap-2">
            <% if (currentUser) { %>
              <a href="/admin/dashboard" class="btn btn-primary btn-lg rounded-3">
                <i class="fa-solid fa-gauge me-1"></i> Open Dashboard
              </a>
              <a href="/shortlist" class="btn btn-outline-primary btn-lg rounded-3">
                <i class="fa-solid fa-filter me-1"></i> Shortlist Engine
              </a>
            <% } else { %>
              <a href="/auth/login" class="btn btn-primary btn-lg rounded-3">
                <i class="fa-solid fa-right-to-bracket me-1"></i> Admin Login
              </a>
              <a href="/auth/signup" class="btn btn-outline-primary btn-lg rounded-3">
                <i class="fa-solid fa-user-plus me-1"></i> Register as Admin
              </a>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Student Drive Actions Card -->
    <div class="col-md-5 col-lg-4">
      <div class="card shadow-sm border-0 h-100 rounded-3">
        <div class="card-body d-flex flex-column justify-content-between p-4 text-center">
          <div>
            <div class="rounded-circle bg-success bg-opacity-10 text-success d-inline-flex p-3 mb-3">
              <i class="fa-solid fa-graduation-cap fs-3"></i>
            </div>
            <h5 class="card-title fw-bold mb-2">Student Placements</h5>
            <p class="text-muted small mb-4">
              Browse upcoming company visits, verify your eligibility criteria, submit your placement applications, and view drive results.
            </p>
          </div>
          <div class="d-grid gap-2">
            <a href="/drives" class="btn btn-success btn-lg rounded-3">
              <i class="fa-solid fa-briefcase me-1"></i> View Active Drives
            </a>
            <a href="/drives/results" class="btn btn-outline-success btn-lg rounded-3">
              <i class="fa-solid fa-square-poll-vertical me-1"></i> Placement Results
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
