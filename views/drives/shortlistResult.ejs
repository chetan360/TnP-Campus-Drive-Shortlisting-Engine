<% layout("./layouts/boilerplate") %>

<div class="container py-4">
  <!-- Top Navigation & Title -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1">Shortlist Results for <%= drive.name %></h2>
      <p class="text-muted mb-0">Role: <strong><%= drive.role %></strong> | Package: <strong><%= drive.package %></strong></p>
    </div>
    <div class="mt-2 mt-md-0">
      <a href="/admin/dashboard" class="btn btn-outline-secondary rounded-3 me-2">
        <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
      </a>
      <button onclick="window.print()" class="btn btn-outline-primary rounded-3">
        <i class="fa-solid fa-print me-1"></i> Print / Export
      </button>
    </div>
  </div>

  <!-- Criteria Info Card -->
  <div class="card border-0 shadow-sm rounded-3 mb-4 bg-light">
    <div class="card-body p-3">
      <div class="row text-center g-2">
        <div class="col-6 col-md">
          <small class="text-muted d-block">Min 10th %</small>
          <strong class="fs-6 text-dark"><%= drive.criteria.minTenthPercentage %>%</strong>
        </div>
        <div class="col-6 col-md">
          <small class="text-muted d-block">Min 12th %</small>
          <strong class="fs-6 text-dark"><%= drive.criteria.minTwelfthPercentage %>%</strong>
        </div>
        <div class="col-6 col-md">
          <small class="text-muted d-block">Min UG CGPA</small>
          <strong class="fs-6 text-dark"><%= drive.criteria.minUgCgpa %></strong>
        </div>
        <div class="col-6 col-md">
          <small class="text-muted d-block">Min PG CGPA</small>
          <strong class="fs-6 text-dark"><%= drive.criteria.minPgCgpa %></strong>
        </div>
        <div class="col-6 col-md">
          <small class="text-muted d-block">Max Backlogs</small>
          <strong class="fs-6 text-dark">&le; <%= drive.criteria.maxBacklogs %></strong>
        </div>
        <div class="col-12 col-md">
          <small class="text-muted d-block">Filter Scope</small>
          <span class="badge <%= filterScope === 'applicants' ? 'bg-primary' : 'bg-secondary' %>">
            <%= filterScope === 'applicants' ? 'Applied Candidates (' + totalApplicants + ')' : 'All Registered Students Pool' %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Results Table -->
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="fw-bold mb-0">Eligible Candidates</h5>
      <span class="badge bg-success rounded-pill px-3 py-2"><%= shortlistedStudents.length %> Shortlisted</span>
    </div>

    <div class="card-body p-0">
      <% if (shortlistedStudents && shortlistedStudents.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th scope="col" class="ps-3">#</th>
                <th scope="col">Student Name</th>
                <th scope="col">Roll / PRN</th>
                <th scope="col">Branch</th>
                <th scope="col">10th %</th>
                <th scope="col">12th %</th>
                <th scope="col">UG CGPA</th>
                <th scope="col">PG CGPA</th>
                <th scope="col">Backlogs</th>
                <th scope="col" class="text-end pe-3">Resume</th>
              </tr>
            </thead>
            <tbody>
              <% shortlistedStudents.forEach((student, index) => { %>
                <tr>
                  <td class="ps-3 text-muted"><%= index + 1 %></td>
                  <td>
                    <div class="fw-bold text-dark"><%= student.name %></div>
                  </td>
                  <td><code><%= student.rollNo %></code></td>
                  <td><span class="badge bg-light text-dark border"><%= student.branch %></span></td>
                  <td><%= student.tenthPercentage %>%</td>
                  <td><%= student.twelfthPercentage %>%</td>
                  <td><strong class="text-primary"><%= student.ugCgpa %></strong></td>
                  <td><%= student.pgCgpa %></td>
                  <td>
                    <span class="badge <%= student.activeBacklogs === 0 ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' %>">
                      <%= student.activeBacklogs %>
                    </span>
                  </td>
                  <td class="text-end pe-3">
                    <% if (student.resumeLink) { %>
                      <a href="<%= student.resumeLink %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                        <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> View Resume
                      </a>
                    <% } else { %>
                      <span class="text-muted small">N/A</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="text-center py-5">
          <i class="fa-solid fa-user-xmark fs-1 text-muted mb-3 d-block"></i>
          <h5 class="fw-bold">No students met the criteria</h5>
          <p class="text-muted small mb-0">None of the <%= filterScope === 'applicants' ? 'applied' : 'registered' %> students matched the cutoff requirements for this drive.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>
