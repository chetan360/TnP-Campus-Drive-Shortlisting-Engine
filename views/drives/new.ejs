<% layout("./layouts/boilerplate") %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom">
          <div class="d-flex justify-content-between align-items-center">
            <h4 class="fw-bold mb-0">Create Campus Drive</h4>
            <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm">
              <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
            </a>
          </div>
        </div>

        <div class="card-body p-4">
          <form action="/drives" method="POST" class="needs-validation" novalidate>
            <!-- Basic Information -->
            <h5 class="fw-bold text-primary mb-3">Company Information</h5>
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label for="name" class="form-label fw-semibold">Company Name *</label>
                <input
                  type="text"
                  class="form-control rounded-3"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Google, Microsoft, Infosys"
                />
              </div>

              <div class="col-md-6">
                <label for="role" class="form-label fw-semibold">Job Role / Designation *</label>
                <input
                  type="text"
                  class="form-control rounded-3"
                  id="role"
                  name="role"
                  required
                  placeholder="e.g. Software Engineer, Data Analyst"
                />
              </div>

              <div class="col-md-6">
                <label for="package" class="form-label fw-semibold">Compensation Package *</label>
                <input
                  type="text"
                  class="form-control rounded-3"
                  id="package"
                  name="package"
                  required
                  placeholder="e.g. 12 LPA, 8.5 LPA"
                />
              </div>

              <div class="col-md-6">
                <label for="deadline" class="form-label fw-semibold">Application Deadline *</label>
                <input
                  type="date"
                  class="form-control rounded-3"
                  id="deadline"
                  name="deadline"
                  required
                />
              </div>

              <div class="col-12">
                <label for="description" class="form-label fw-semibold">Drive Description *</label>
                <textarea
                  class="form-control rounded-3"
                  id="description"
                  name="description"
                  rows="3"
                  required
                  placeholder="Describe the job profile, responsibilities, selection rounds, and perks..."
                ></textarea>
              </div>
            </div>

            <!-- Eligibility Criteria -->
            <h5 class="fw-bold text-primary mb-3">Eligibility Criteria</h5>
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label for="minTenthPercentage" class="form-label fw-semibold">Min 10th Percentage (%) *</label>
                <input
                  type="number"
                  step="0.01"
                  min="0"
                  max="100"
                  class="form-control rounded-3"
                  id="minTenthPercentage"
                  name="minTenthPercentage"
                  value="60"
                  required
                />
              </div>

              <div class="col-md-6">
                <label for="minTwelfthPercentage" class="form-label fw-semibold">Min 12th / Diploma Percentage (%) *</label>
                <input
                  type="number"
                  step="0.01"
                  min="0"
                  max="100"
                  class="form-control rounded-3"
                  id="minTwelfthPercentage"
                  name="minTwelfthPercentage"
                  value="60"
                  required
                />
              </div>

              <div class="col-md-4">
                <label for="minUgCgpa" class="form-label fw-semibold">Min UG CGPA *</label>
                <input
                  type="number"
                  step="0.01"
                  min="0"
                  max="10"
                  class="form-control rounded-3"
                  id="minUgCgpa"
                  name="minUgCgpa"
                  value="6.5"
                  required
                />
              </div>

              <div class="col-md-4">
                <label for="minPgCgpa" class="form-label fw-semibold">Min PG CGPA *</label>
                <input
                  type="number"
                  step="0.01"
                  min="0"
                  max="10"
                  class="form-control rounded-3"
                  id="minPgCgpa"
                  name="minPgCgpa"
                  value="6.5"
                  required
                />
              </div>

              <div class="col-md-4">
                <label for="maxBacklogs" class="form-label fw-semibold">Max Active Backlogs Allowed *</label>
                <input
                  type="number"
                  min="0"
                  class="form-control rounded-3"
                  id="maxBacklogs"
                  name="maxBacklogs"
                  value="0"
                  required
                />
              </div>
            </div>

            <!-- Submit Button -->
            <div class="d-flex justify-content-end gap-2">
              <a href="/admin/dashboard" class="btn btn-outline-secondary rounded-3 px-4">Cancel</a>
              <button type="submit" class="btn btn-primary rounded-3 px-4">
                <i class="fa-solid fa-check me-1"></i> Create Drive
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
